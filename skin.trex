<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.projedata.inifexbi.skin" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Skin</name>
    <description>Painéis de fundo com o padrão visual da marca Projedata (cores, blocos, faixas).</description>
    <author name="Projedata" email="ti@projedata.com.br" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/skin.html</url>
    </source-location>

    <icon>iVBORw0KGgoAAAANSUhEUgAAABoAAAAaCAIAAAAmKNuZAAAAN0lEQVR4nGPk4bdloB5goqJZg944FmSOmvkhMoy4ddIOzh7cnh01btS4UeNGjRu0xjGO1mRkAwDhywPl9FMd7wAAAABJRU5ErkJggg==</icon>

    <!--
      Sem <permissions>: a extensão não precisa ler dados do workbook,
      só estiliza o próprio objeto. A tag <permissions> só deve existir
      se contiver ao menos uma <permission> declarada (ex: full data).
    -->
  </dashboard-extension>
</manifest>
