<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.projedata.inifexbi.panel" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Painel de Seção</name>
    <description>Cartão de seção com título e subtítulo no estilo da marca Projedata. Coloque atrás dos gráficos (flutuante, enviar para trás).</description>
    <author name="Projedata" email="" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/html/panel.html</url>
    </source-location>

    <icon></icon>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
</manifest>
