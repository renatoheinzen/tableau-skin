<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.projedata.inifexbi.ranklist" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Lista Ranqueada</name>
    <description>Lista Top N com posição e selos de valor, com as cores da marca Projedata.</description>
    <author name="Projedata" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/html/rank-list.html</url>
    </source-location>

    <icon></icon>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </worksheet-extension>
</manifest>
