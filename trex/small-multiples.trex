<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.projedata.inifexbi.smallmultiples" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Mini-gráficos por Coorte</name>
    <description>Um mini-gráfico (linha, área ou barras) por coorte/categoria, com eixos compartilhados — ideal para CLV e churn por coorte, com as cores da marca Projedata.</description>
    <author name="Projedata" email="" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/html/small-multiples.html</url>
    </source-location>

    <icon></icon>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </worksheet-extension>
</manifest>
