<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.projedata.inifexbi.maplegend" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Legenda de Mapa</name>
    <description>Legenda (degradê mínimo–máximo e Top N) para o mapa nativo do Tableau, com a escala de cores da marca Projedata.</description>
    <author name="Projedata" email="" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/html/map-legend.html</url>
    </source-location>

    <icon></icon>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </worksheet-extension>
</manifest>
