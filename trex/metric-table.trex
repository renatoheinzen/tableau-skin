<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.projedata.inifexbi.metrictable" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Tabela de Mini-gráficos</name>
    <description>Tabela com uma linha por categoria e até 4 medidas lado a lado, cada uma com barra ou ponto e sparkline opcional, com as cores da marca Projedata.</description>
    <author name="Projedata" email="" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/html/metric-table.html</url>
    </source-location>

    <icon></icon>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </worksheet-extension>
</manifest>
