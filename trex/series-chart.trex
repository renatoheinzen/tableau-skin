<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.projedata.inifexbi.serieschart" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Gráfico de Séries</name>
    <description>Barras empilhadas, 100%, agrupadas, linhas múltiplas, área empilhada e combinação barras + linha, com a paleta de série da marca Projedata.</description>
    <author name="Projedata" email="" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/html/series-chart.html</url>
    </source-location>

    <icon></icon>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </worksheet-extension>
</manifest>
