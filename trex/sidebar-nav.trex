<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.projedata.inifexbi.sidebarnav" extension-version="1.0.0">
    <default-locale>pt_BR</default-locale>
    <name>Projedata Faixa Lateral</name>
    <description>Faixa lateral de navegação (itens com ícone, item ativo, links ou parâmetro) no estilo da marca Projedata.</description>
    <author name="Projedata" email="ti@projedata.com.br" organization="Projedata" website="https://www.projedata.com.br" />
    <min-api-version>1.9</min-api-version>

    <source-location>
      <url>https://renatoheinzen.github.io/tableau-skin/html/sidebar-nav.html</url>
    </source-location>

    <icon></icon>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
</manifest>
